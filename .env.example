# ==============================================
# BURKINA WATCH - CONFIGURATION ENVIRONNEMENT
# ==============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ==============================================
# SURVEILLANCE — GATEWAY VIDÉO CONTRÔLÉ
# ==============================================

# Désactivé par défaut. Ne jamais activer les caméras réelles en production
# sans une architecture réseau privée et une validation séparée.
VIDEO_GATEWAY_ENABLED=false
VIDEO_GATEWAY_PROVIDER=disabled
VIDEO_GATEWAY_TEST_MODE=false
VIDEO_GATEWAY_REAL_CAMERA_ENABLED=false
VIDEO_GATEWAY_ALLOW_PRIVATE_NETWORK=false
VIDEO_GATEWAY_MAX_VIEWERS_PER_CAMERA=8
VIDEO_GATEWAY_API_URL=http://127.0.0.1:9997
VIDEO_GATEWAY_PUBLIC_ORIGIN=http://127.0.0.1:8889
# Requis uniquement avec VIDEO_GATEWAY_REAL_CAMERA_ENABLED=true.
VIDEO_GATEWAY_API_TOKEN=
VIDEO_GATEWAY_PATH_SECRET=
# Local Phase 8.2 only. Keep empty outside the isolated prototype.
VIDEO_GATEWAY_PUBLISHER_USERNAME=
VIDEO_GATEWAY_PUBLISHER_PASSWORD=

# ==============================================
# BASE DE DONNÉES POSTGRESQL
# ==============================================

# URL de connexion complète.
# En production, Railway PostgreSQL est la source de vérité et la variable
# RAILWAY_DATABASE_URL doit être fournie dans le gestionnaire de secrets.
DATABASE_URL=postgresql://username:password@localhost:5432/burkina_watch
RAILWAY_DATABASE_URL=

# StreetView Phase 3 — limites d'upload et stockage séparé de PostgreSQL.
STREETVIEW_MAX_VIDEO_MB=100
STREETVIEW_MIN_DURATION_SECONDS=2
STREETVIEW_MAX_DURATION_SECONDS=180
STREETVIEW_MAX_THUMBNAIL_KB=512
# En développement, filesystem conserve le flux local historique.
# En production, laisser vide sélectionne s3 et échoue fermé si sa configuration manque.
STREETVIEW_STORAGE_PROVIDER=filesystem
STREETVIEW_STORAGE_DIR=uploads/streetview
# true uniquement si ce chemin est un volume persistant configuré.
STREETVIEW_STORAGE_DURABLE=false
# Stockage objet S3-compatible recommandé pour Railway (Cloudflare R2, AWS S3, etc.).
# Ces variables restent uniquement dans les secrets/environnements de déploiement.
STREETVIEW_S3_ENDPOINT=
STREETVIEW_S3_REGION=auto
STREETVIEW_S3_BUCKET=
STREETVIEW_S3_ACCESS_KEY_ID=
STREETVIEW_S3_SECRET_ACCESS_KEY=
STREETVIEW_S3_SESSION_TOKEN=
STREETVIEW_S3_FORCE_PATH_STYLE=false
STREETVIEW_S3_SIGNED_URL_TTL_SECONDS=900
STREETVIEW_S3_MULTIPART_PART_SIZE_MB=8

# StreetView Phase 5 — worker séparé et queue PostgreSQL.
# Le service web reste désactivé par défaut; le service Railway worker doit
# utiliser STREETVIEW_WORKER_ENABLED=true via sa commande dédiée.
STREETVIEW_WORKER_ENABLED=false
STREETVIEW_WORKER_ID=
STREETVIEW_WORKER_POLL_MS=2000
STREETVIEW_WORKER_LEASE_MS=300000
STREETVIEW_RETRY_BASE_MS=5000
STREETVIEW_RETRY_MAX_MS=300000

# Configuration PostgreSQL (alternative à DATABASE_URL)
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=burkina_watch
PGHOST=localhost
PGPORT=5432

# ==============================================
# SESSIONS & SÉCURITÉ
# ==============================================

# Secret pour les sessions (OBLIGATOIRE en production, 32 caractères minimum)
# Générer avec: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_very_long_random_secret_key_at_least_32_characters

# Secret distinct facultatif pour le HMAC des OTP (sinon SESSION_SECRET est utilisé)
OTP_HASH_SECRET=

# ==============================================
# CHIFFREMENT & SÉCURITÉ AVANCÉE
# ==============================================

# Clé principale de chiffrement (32 bytes en hexadécimal = 64 caractères)
# Générer avec: openssl rand -hex 32
# CRITIQUE: Cette clé chiffre toutes les données sensibles. NE JAMAIS LA DIVULGUER!
MASTER_ENCRYPTION_KEY=

# Salt pour le hachage des refresh tokens
# Générer avec: openssl rand -hex 32
REFRESH_TOKEN_SALT=

# Secret JWT pour les access tokens (15 minutes)
# Générer avec: openssl rand -hex 32
JWT_SECRET=

# Secret JWT pour les refresh tokens (7 jours)
# Générer avec: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Durée de vie des access tokens en secondes (par défaut: 900 = 15 minutes)
JWT_EXPIRATION=900

# Durée de vie des refresh tokens en secondes (par défaut: 604800 = 7 jours)
JWT_REFRESH_EXPIRATION=604800

# ==============================================
# GOOGLE CLOUD KMS (recommandé pour la production)
# ==============================================

# Activer Google Cloud KMS pour gestion sécurisée des clés
KMS_ENABLED=false

# ID du projet Google Cloud
KMS_PROJECT_ID=

# Localisation de la clé (ex: global, us-east1)
KMS_LOCATION_ID=global

# ID du trousseau de clés
KMS_KEY_RING_ID=

# ID de la clé de chiffrement
KMS_CRYPTO_KEY_ID=

# Chemin vers le fichier de credentials JSON Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================
# AUTHENTIFICATION OIDC (REPLIT AUTH)
# ==============================================

# URL de l'émetteur OIDC
ISSUER_URL=https://replit.com/id/oidc

# Identifiant client OIDC (obtenu depuis Replit)
CLIENT_ID=your_replit_client_id

# Secret client OIDC (obtenu depuis Replit)
CLIENT_SECRET=your_replit_client_secret

# URL de redirection après authentification
REDIRECT_URI=https://your-repl-name.your-username.repl.co/api/auth/callback

# ==============================================
# SERVICE EMAIL (RESEND)
# ==============================================

# Clé API Resend pour l'envoi d'emails
# Obtenez-la sur: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email d'expéditeur (doit être vérifié sur Resend)
FROM_EMAIL=noreply@burkinawatch.com

# ==============================================
# GOOGLE MAPS API (OPTIONNEL)
# ==============================================

# Clé API Google Maps pour la carte interactive
# Obtenez-la sur: https://console.cloud.google.com
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================
# INTELLIGENCE ARTIFICIELLE (GEMINI & GROQ)
# ==============================================

# Clé API Google Gemini pour le chatbot "Assistance Burkina Watch" (moteur principal)
# Obtenez-la sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Clé API Groq pour le chatbot "Assistance Burkina Watch" (moteur de secours)
# Obtenez-la sur: https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq autorisé par votre clé (modifiable selon la liste Groq disponible)
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================
# CONFIGURATION SERVEUR
# ==============================================

# Port sur lequel l'application écoute
PORT=5000

# Environnement (development | production)
NODE_ENV=development

# ==============================================
# DOMAINES & URLS (Pour Replit ou Production)
# ==============================================

# Domaine de l'application
REPLIT_DOMAINS=your-repl-name.your-username.repl.co

# URL de base de l'application
BASE_URL=https://your-repl-name.your-username.repl.co

# Origines exactes autorisées pour une future passerelle média (jamais '*')
# Exemple: https://media.example.com,wss://media.example.com
MEDIA_GATEWAY_ORIGINS=

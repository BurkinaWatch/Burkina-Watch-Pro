{
  "expo": {
    "name": "BurkinaWatch Mobile",
    "slug": "burkinawatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FC"
    },
    "scheme": "burkinawatch-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BurkinaWatch utilise votre position pour le suivi de sécurité en direct."
      }
    },
    "android": {
      "package": "com.burkinawatch.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BurkinaWatch utilise votre position pour le suivi de sécurité en direct."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ceea1e43-cf44-46bb-a41e-b5a958e043ac"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ceea1e43-cf44-46bb-a41e-b5a958e043ac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "burkinawatch"
  }
}

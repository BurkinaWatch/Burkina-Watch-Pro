# PostgreSQL connection string (the only supported database variable):
# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required by the API server process.
PORT=8080

# Production mode and security configuration.
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SALT=replace-with-a-stable-secret

# Required when KMS_ENABLED=false (the default).
# Use a 64-character hexadecimal value.
KMS_ENABLED=false
MASTER_ENCRYPTION_KEY=replace-with-64-hex-characters

# If KMS_ENABLED=true, configure these instead of MASTER_ENCRYPTION_KEY.
# KMS_PROJECT_ID=
# KMS_LOCATION_ID=
# KMS_KEY_RING_ID=
# KMS_CRYPTO_KEY_ID=